# ──────────────────────────────────────────────
# DRENZO AI — Environment Variables (Example)
# Copy this to .env and fill in your values
# VITE_* = client-side (exposed to browser)
# Others = server-only (set in Vercel Dashboard)
# ──────────────────────────────────────────────

# Google OAuth (client-side)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Cloudinary (server-side — set in Vercel Dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=Drenzo AI

# OpenCode Zen API (server-side)
OPENCODE_API_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=sk-your-api-key
OPENCODE_MODEL=mimo-v2.5-free
OPENCODE_SESSION_ID=drenzo-ai-free

# Tavily (optional, free tier: 1000/mo)
TAVILY_API_KEY=
